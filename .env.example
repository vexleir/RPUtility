# RP Utility — Environment Configuration
# Copy this file to .env and edit as needed.
# All variables use the RP_ prefix.

# ── Provider ──────────────────────────────────────────────────────────────────
RP_PROVIDER=ollama                        # "ollama" or "lmstudio"

# Ollama settings
RP_OLLAMA_BASE_URL=http://localhost:11434
RP_OLLAMA_MODEL=llama3.2                  # any model you have pulled

# LM Studio settings
RP_LMSTUDIO_BASE_URL=http://localhost:1234
RP_LMSTUDIO_MODEL=local-model             # usually ignored; LM Studio uses the loaded model

# ── Generation ────────────────────────────────────────────────────────────────
RP_TEMPERATURE=0.8
RP_MAX_TOKENS=1024

# ── Memory ────────────────────────────────────────────────────────────────────
RP_MEMORY_EXTRACTION_ENABLED=true
RP_MAX_RETRIEVED_MEMORIES=10
# RP_EXTRACTION_MODEL=llama3.2:1b        # optional smaller model for extraction

# ── Lorebook ──────────────────────────────────────────────────────────────────
RP_MAX_LOREBOOK_ENTRIES=5

# ── Prompt ────────────────────────────────────────────────────────────────────
RP_MEMORY_INJECTION_MODE=soft             # "soft" or "raw"

# ── Debug ─────────────────────────────────────────────────────────────────────
RP_DEBUG=false
RP_SHOW_PROMPT=false
RP_SHOW_MEMORY_EXTRACTION=false
